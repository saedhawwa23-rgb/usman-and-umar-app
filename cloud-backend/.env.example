# Required: generate a strong random value and enter the same token in the Android app.
APP_CLIENT_TOKEN=

# Preferred inference provider. NVIDIA uses an OpenAI-compatible chat endpoint.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b

# Fallback provider when NVIDIA_API_KEY is unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
