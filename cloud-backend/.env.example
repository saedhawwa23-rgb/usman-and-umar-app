# Required: HTTPS URL of an actual OpenSwarm /execute-compatible API.
OPEN_SWARM_EXECUTE_URL=

# Required: generate a random value and enter the same token in the Android app.
APP_CLIENT_TOKEN=

# Optional: upstream bearer token if your OpenSwarm service requires it.
OPEN_SWARM_BEARER_TOKEN=

# Optional: true is for clearly labeled connection tests only; keep false in production.
ENABLE_MOCK_EXECUTION=false
