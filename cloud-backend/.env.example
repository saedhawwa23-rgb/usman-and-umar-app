# Required: generate a strong random value and enter the same token in the Android app.
APP_CLIENT_TOKEN=

# Recommended for Colab/direct execution. Add this as a Colab Secret; never commit its value.
# Without it, browser_use_interactive.py requires a local Ollama server and model.
OPENROUTER_API_KEY=

# Optional OpenRouter model slug; defaults to the free-model router when a key is present.
OPENROUTER_MODEL=openrouter/free
