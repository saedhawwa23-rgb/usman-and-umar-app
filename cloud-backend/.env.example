# Required: generate a strong random value and enter the same token in the Android app.
APP_CLIENT_TOKEN=

# Preferred inference provider. When configured, execution is pinned to this exact model.
# NVIDIA endpoint: https://integrate.api.nvidia.com/v1/chat/completions
# Model: nvidia/nemotron-3.5-bolt-e4b
NVIDIA_API_KEY=

# Fallback provider only when NVIDIA_API_KEY is unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
