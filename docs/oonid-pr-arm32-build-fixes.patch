     local sysroot
     sysroot="$(get_sysroot "$arch")"
 
@@ -138,7 +141,7 @@ setup_sysroot() {
     mkdir -p "${sysroot}/usr/lib" "${sysroot}/usr/include"
 
     cp -a "${ndk_sysroot}/usr/include" "${sysroot}/usr/"
