+if len(data) < 64 or data[:4] != b'\x7fELF' or data[5] != 1:
+    raise SystemExit('Expected a little-endian ELF file')
+if data[4] == 1:  # ELF32
+    e_phoff = struct.unpack_from('<I', data, 28)[0]
